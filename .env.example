# ============================================================================
#  WaBridge configuration
#  Copy to ".env" (windows\setup.ps1 does this for you and fills the secrets).
# ============================================================================

# --- REQUIRED --------------------------------------------------------------
# Shared secret between WaBridge and the OpenWA engine (32+ random characters).
# The engine uses it as its admin key; WaBridge uses it to call the engine.
OPENWA_API_KEY=

# Signs WaBridge login cookies. 32+ random characters. Keep it stable.
WABRIDGE_SECRET=

# Extra secret the engine mixes into stored API-key hashes (set once, never change).
OPENWA_API_KEY_PEPPER=

# --- OPTIONAL: AI auto-replies (Claude) -------------------------------------
# Get a key at https://console.anthropic.com → API keys. You can also paste it
# later in WaBridge → Automations & AI → AI assistant.
ANTHROPIC_API_KEY=

# --- OPTIONAL: Official Meta WhatsApp Cloud API ------------------------------
# Only needed for approved-template campaigns / an official fallback channel.
# Can also be entered in WaBridge → Integrations → Official API (Meta).
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# --- Engine tuning -----------------------------------------------------------
# whatsapp-web.js = safer (uses ~300-500 MB RAM per number)
# baileys         = lighter (~50 MB per number) but easier for WhatsApp to detect
OPENWA_ENGINE=whatsapp-web.js
OPENWA_VERSION=0.25.0
# Engine-side daily warm-up limits for new numbers (20 → 40 → 80 → … per day)
OPENWA_SEND_PACING=true
OPENWA_MEM_LIMIT=2g
TZ=Asia/Kolkata

# --- Website contact form (optional) ---------------------------------------
# Lets your marketing site's contact form create contacts in WaBridge via
# POST /api/public/leads. List the exact website origin(s), comma separated.
# Leave empty to keep the endpoint switched off.
LEAD_FORM_ORIGINS=

# --- Network -----------------------------------------------------------------
# 127.0.0.1 = only this laptop can open the dashboard. Use 0.0.0.0 for your LAN.
WABRIDGE_BIND=127.0.0.1
WABRIDGE_PORT=8080
# Set to true only when WaBridge is served over HTTPS (e.g. Cloudflare Tunnel).
COOKIE_SECURE=false

# --- Only for running WITHOUT Docker (npm start) -----------------------------
# PORT=8080
# OPENWA_URL=http://localhost:2785
# WABRIDGE_PUBLIC_URL=http://localhost:8080
